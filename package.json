{
  "name": "http-dht-proxy",
  "version": "1.0.0",
  "description": "Relay http request to dht peer",
  "main": "index.js",
  "bin": {
    "http-dht-proxy": "bin.js",
    "http-dht-proxy-bare": "bin-bare.js"
  },
  "files": [
    "bin.js",
    "bin-bare.js"
  ],
  "scripts": {
    "lint": "prettier --check . && lunte",
    "format": "prettier --write . && lunte --fix",
    "test": "brittle -c test.js",
    "test-bare": "brittle-bare -c test.js"
  },
  "dependencies": {
    "bare-net": "^2.2.0",
    "bare-process": "^4.3.0",
    "http-forward-host": "^1.0.0",
    "hypercore-id-encoding": "^1.3.0",
    "hyperdht": "^6.27.0"
  },
  "devDependencies": {
    "brittle": "^3.19.0",
    "lunte": "^1.6.0",
    "prettier": "^3.6.2",
    "prettier-config-holepunch": "^2.0.0",
    "resolve-reject-promise": "^1.1.0"
  },
  "imports": {
    "net": {
      "bare": "bare-net",
      "default": "net"
    },
    "process": {
      "bare": "bare-process",
      "default": "process"
    }
  },
  "author": "Holepunch",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/holepunchto/http-dht-proxy.git"
  },
  "bugs": {
    "url": "https://github.com/holepunchto/http-dht-proxy/issues"
  },
  "homepage": "https://github.com/holepunchto/http-dht-proxy"
}
